{
  "style": {
    "type": "string",
    "description": "配色风格（固定）",
    "hint": "deepseek = DeepSeek 蓝调（#0066FF）。旧版 claude 值仍可读取以兼容老安装，面板已不再提供该风格。",
    "default": "deepseek",
    "options": [
      "deepseek"
    ]
  },
  "theme": {
    "type": "string",
    "description": "默认主题",
    "hint": "ivory = 象牙白画布，ink = 纯黑画布。面板里选中后会写入本地 settings.json 优先于此项",
    "default": "ivory",
    "options": [
      "ivory",
      "ink"
    ]
  },
  "zoom": {
    "type": "int",
    "description": "页面缩放（%）",
    "hint": "80 ~ 140 之间，默认 100",
    "default": 100
  },
  "tooltip": {
    "type": "bool",
    "description": "悬浮参数提示",
    "hint": "鼠标悬浮参数项时显示轻量说明；关闭后不再弹出",
    "default": true
  },
  "warn_percent": {
    "type": "int",
    "description": "预警阈值（%）",
    "hint": "达到该占比时黄色预警；高危线固定 95%",
    "default": 80
  },
  "auto_broadcast": {
    "type": "bool",
    "description": "自动进度播报",
    "hint": "仅当会话用量越过预警阈值时推送一次，同一会话 30 分钟内不会重复播报",
    "default": true
  },
  "debug_log": {
    "type": "bool",
    "description": "调试日志",
    "hint": "打开后把读取失败、面板请求等细节写进 AstrBot 日志，便于排查",
    "default": false
  },
  "diary": {
    "type": "object",
    "description": "会话日记本",
    "hint": "独立于上下文压缩与承接的长期记忆；面板「日记本」页可单独开关与调参",
    "items": {
      "enable": {
        "type": "bool",
        "description": "启用日记本",
        "hint": "关闭后不写入日记、也不检索注入，原有面板与聊天逻辑完全不受影响",
        "default": false
      },
      "max_per_day": {
        "type": "int",
        "description": "单日最多篇数",
        "hint": "1 ~ 3，由模型按记忆权重自行决定写不写、写几篇",
        "default": 3
      },
      "max_single_length": {
        "type": "int",
        "description": "单篇字数上限",
        "hint": "60 ~ 1000，超出自动截断",
        "default": 260
      },
      "inject_relevant_count": {
        "type": "int",
        "description": "每次注入条数",
        "hint": "1 ~ 10，只注入与当前提问最相关的高权重日记",
        "default": 3
      }
    }
  }
}
