{
  "id": "astrbot_plugin_token_panel",
  "name": "astrbot_plugin_token_panel",
  "display_name": "PLUTO panel（普鲁托面板）",
  "version": "1.5.5",
  "author": "Charon",
  "license": "MIT",
  "description": "会话上下文 Token 用量可视化面板：进度条、预警阈值、自动播报、一键清空；内置上下文统计（/ctx）、压缩与承接（/ctx_compress、/ctx_continue、/ctx_sessions、/ctx_switch）、联网搜索与抖音游客浏览监控，带情绪等级与静默策略的精细化主动消息，以及抖音风控调速（近 3 天加权分数、90 分钟回升周期、8 秒停留硬底线）。",
  "short_description": "PLUTO panel：Token 面板 + 上下文压缩承接 + 主动消息",
  "repo": "https://github.com/Charon/astrbot_plugin_token_panel",
  "homepage": "",
  "keywords": [
    "astrbot",
    "astrbot-plugin",
    "token",
    "context",
    "llm",
    "dashboard",
    "onebot"
  ],
  "categories": [
    "工具",
    "管理"
  ],
  "astrbot_version": ">=4.11.4",
  "entry": "main.py",
  "views": [
    "views/dashboard/index.html"
  ],
  "requires": [],
  "commands": [
    "/token_ctx",
    "/token_ctxon",
    "/token_ctxoff",
    "/token_ctxset",
    "/token_clearctx",
    "/ctx",
    "/ctx_compress",
    "/ctx_continue",
    "/ctx_sessions",
    "/ctx_switch",
    "/ctx_auto",
    "dy_on",
    "dy_off",
    "dy_test",
    "dy_status",
    "dy_log",
    "dy_set",
    "net_log",
    "/proactive",
    "/proactive-status",
    "/proactive-reset"
  ],
  "icon": "assets/icon.png",
  "banner": "assets/banner.png"
}
